# Optional stock photo APIs. Without keys the app still works (Wikimedia Commons + neutral cards).
# Pexels: free, 200 requests/hour. https://www.pexels.com/api/
PEXELS_API_KEY=
# Unsplash: free demo tier, 50 requests/hour. https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Database (Supabase). Run db/schema.sql once, then fill these. Server-only; never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Passcode asked once per browser before posts load from / save to the database.
APP_PASSCODE=
